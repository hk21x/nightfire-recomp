# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe     # the on-foot levels; Driving.xbe (the driving levels) is the NightfireDriving target
GAME_LOG=nightfire       # GameInfo::log
GAME_TARGET=Nightfire    # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=nightfire
SMOKE_PAD=scripts/pad/none.txt  # to be replaced by a pad that reaches a level once the game boots
SMOKE_MENU=              # "first last" vertical blanks where a 2D menu is up before the pad's menu choice
SOAK_PAD=                # a program printing a pad script for N seconds of play, over and over
