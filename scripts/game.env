# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe     # title and on-foot levels; Driving.xbe (front end, driving levels) is NightfireDriving
GAME_LOG=nightfire       # GameInfo::log
GAME_TARGET=Nightfire    # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=nightfire
SMOKE_PAD=scripts/pad/smoke.txt  # language select, movies, the title; START relaunches into Driving.xbe
SMOKE_MENU="1620 1980"   # the title's "Press START" (2D, about 24 draws a frame) before START
SMOKE_SECS=45            # default.xbe's part: START at 2000 vertical blanks relaunches at about 34 s
SMOKE_NEXT_GEN=generated/driving  # then Driving.xbe (EA's front end and driving levels) on that disk and launch data
SMOKE_NEXT_NAME=driving
SMOKE_NEXT_PAD=scripts/pad/paris.txt  # the Paris intro movie, the sniper tutorial, the chase
SMOKE_NEXT_SECS=150
SOAK_PAD=                # a program printing a pad script for N seconds of play, over and over
